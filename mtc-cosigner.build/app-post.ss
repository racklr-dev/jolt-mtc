;; === launcher ===
(suppress-greeting #t)
(jolt-install-gc-policy!)
(jolt-install-stack-limit!)
(scheme-start
  (lambda args
(jolt-startup-profile-mark! "scheme-start begin")
    (jolt-install-exit-handler!)
    (jolt-arm-signals!)
    (jolt-sample-init-from-env!)
    (jolt-block-profile-at-exit! "release")
    (guard (v (#t (jolt-report-throwable v (current-error-port)) (exit 1)))
      (jolt-app-init!)
(jolt-build-load-native (list "libcrypto.so.3" "libcrypto.so.1.1" "libcrypto.so" ) #t #f)
(jolt-build-load-native (list "libssl.so.3" "libssl.so.1.1" "libssl.so" ) #t #f)
(jolt-build-load-native (list "libz.so.1" "libz.so" ) #t #f)
(jolt-build-load-native (list "libzstd.so.1" "libzstd.so" ) #t #f)
      (let ((base (or (getenv "JOLT_PWD") ".")))
        (set-source-roots!*
          (append (map (lambda (r) (string-append base "/" r)) (list "src" ))
                  (list "jolt-core" "stdlib" "compatibility" "vendor/fs/src" "vendor/process/src" "vendor/cli/src" "vendor/grenadine/src" "vendor/grenadine-generated"))))
(jolt-startup-profile-mark! "scheme-start setup")
      (let ((maincell (var-cell-lookup "mtc.cosigner-server" "-main")))
        (set-chez-ns! "user")
        (when (and maincell (var-cell-defined? maincell))
          (with-exception-handler
            (lambda (c) (when (serious-condition? c) (jolt-capture-fault! c)) (raise-continuable c))
            (lambda ()
              (jolt-with-ns-load-vars
                (lambda ()
                  (let ((jolt-main-result (apply jolt-invoke (var-cell-root maincell) args)))
                    (jolt-startup-profile-mark! "entry -main")
                    jolt-main-result))))))))
    (jolt-await-user-threads!)
    (exit 0)))

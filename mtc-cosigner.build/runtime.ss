  (let ((_lp$29570 jv$clojure.core/attach-core-doc-meta!) (_la$29571 "clojure.core") (_la$29572 "delay?") (_la$29573 "returns true if x is a Delay created with delay") (_la$29574 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$29570) (_lp$29570 _la$29571 _la$29572 _la$29573 _la$29574 jolt-nil) (jolt-invoke _lp$29570 _la$29571 _la$29572 _la$29573 _la$29574 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29575 jv$clojure.core/attach-core-doc-meta!) (_la$29576 "clojure.core") (_la$29577 "deliver") (_la$29578 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29579 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29575) (_lp$29575 _la$29576 _la$29577 _la$29578 _la$29579 jolt-nil) (jolt-invoke _lp$29575 _la$29576 _la$29577 _la$29578 _la$29579 jolt-nil))))

  (let ((_lp$29580 jv$clojure.core/attach-core-doc-meta!) (_la$29581 "clojure.core") (_la$29582 "denominator") (_la$29583 "Returns the denominator part of a Ratio.") (_la$29584 (jolt-list-pos 814 4 (jolt-vector (jolt-symbol #f "r")))) (_la$29585 (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "java.math.BigInteger"))) (if (#3%procedure? _lp$29580) (_lp$29580 _la$29581 _la$29582 _la$29583 _la$29584 _la$29585) (jolt-invoke _lp$29580 _la$29581 _la$29582 _la$29583 _la$29584 _la$29585))))
(guard (e (#t #f))
  (let ((_lp$29586 jv$clojure.core/attach-core-doc-meta!) (_la$29587 "clojure.core") (_la$29588 "deref") (_la$29589 "Also reader macro: @ref/@agent/@var/@atom/@delay/@future/@promise. Within a transaction,\n  returns the in-transaction-value of ref, else returns the\n  most-recently-committed value of ref. When applied to a var, agent\n  or atom, returns its current state. When applied to a delay, forces\n  it if not already forced. When applied to a future, will block if\n  computation not complete. When applied to a promise, will block\n  until a value is delivered.  The variant taking a timeout can be\n  used for blocking references (futures and promises), and will return\n  timeout-val if the timeout (in milliseconds) is reached before a\n  value is available. See also - realized?.") (_la$29590 (jolt-list-pos 818 4 (jolt-vector (jolt-symbol #f "ref")) (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "timeout-ms") (jolt-symbol #f "timeout-val"))))) (if (#3%procedure? _lp$29586) (_lp$29586 _la$29587 _la$29588 _la$29589 _la$29590 jolt-nil) (jolt-invoke _lp$29586 _la$29587 _la$29588 _la$29589 _la$29590 jolt-nil))))

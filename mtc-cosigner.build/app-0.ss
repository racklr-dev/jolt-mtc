  range outside the array throws before anything is written. offset is always\n  a byte offset into p, as in babashka.ffi. To write a slice of a byte-array,\n  give it a one-byte type: (write-array p :byte arr 0 index count)." _kc$2780 1305 _kc$2781 1 _kc$2782 "jolt/ffi.clj")))) _kc$2783))) (jolt-register-source! "write-array" "jolt.ffi" "write-array" "jolt/ffi.clj" 1305) (jolt-register-callsite! "write-array" 1207 "identical?" #f) (jolt-register-callsite! "write-array" 1248 "__write" #f) (jolt-register-callsite! "write-array" 1249 "__write" #f) (jolt-register-callsite! "write-array" 1249 "bit-and" #f) (jolt-register-callsite! "write-array" 1253 "__write" #f) (jolt-register-callsite! "write-array" 1253 "neg?" #f) (jolt-register-callsite! "write-array" 1254 "__write" #f) (jolt-register-callsite! "write-array" 1266 "count" #f) (jolt-register-callsite! "write-array" 1267 "$Rnot" #f) (jolt-register-callsite! "write-array" 1268 "$R+" #f) (jolt-register-callsite! "write-array" 1268 "<=" #f) (jolt-register-callsite! "write-array" 1269 "ex-info" #f) (jolt-register-callsite! "write-array" 1269 "str" #f) (jolt-register-callsite! "write-array" 1273 "array-carrier" #f) (jolt-register-callsite! "write-array" 1274 "count" #f) (jolt-register-callsite! "write-array" 1274 "nil?" #f) (jolt-register-callsite! "write-array" 1275 "check-array-range" #f) (jolt-register-callsite! "write-array" 1276 "nil?" #f) (jolt-register-callsite! "write-array" 1277 "$R+" #f) (jolt-register-callsite! "write-array" 1277 "__write-array" #t) (jolt-register-callsite! "write-array" 1280 "$R+" #f) (jolt-register-callsite! "write-array" 1280 "__write-array-typed" #f) (jolt-register-callsite! "write-array" 1282 "<" #f) (jolt-register-callsite! "write-array" 1282 "inc" #f) (jolt-register-callsite! "write-array" 1283 "$R+" #f) (jolt-register-callsite! "write-array" 1283 "*" #f) (jolt-register-callsite! "write-array" 1283 "nth" #f) (jolt-register-callsite! "write-array" 1283 "write-array-element" #f) (jolt-regist